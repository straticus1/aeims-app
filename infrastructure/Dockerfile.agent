# AEIMS Agent - Production Dockerfile
# Multi-stage build for Go binary

# Stage 1: Builder
FROM golang:1.22-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Copy go mod files first for caching
COPY agent/go.mod agent/go.sum ./
RUN go mod download

# Copy source code
COPY agent/ ./

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s -X main.Version=1.0.0" \
    -o aeims-agent \
    ./cmd/aeims-agent

# Stage 2: Production Runner
FROM alpine:3.19

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata curl

# Create non-root user
RUN addgroup -g 1001 -S aeims && \
    adduser -u 1001 -S aeims -G aeims

# Copy binary from builder
COPY --from=builder /build/aeims-agent /usr/local/bin/aeims-agent

# Create data directory
RUN mkdir -p /var/lib/aeims && chown aeims:aeims /var/lib/aeims

# Copy default config
COPY agent/config/agent.yaml.example /etc/aeims/agent.yaml

USER aeims

# Expose ports
EXPOSE 9850 9851 9852

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -f http://localhost:9852/health || exit 1

ENTRYPOINT ["/usr/local/bin/aeims-agent"]
CMD ["--config", "/etc/aeims/agent.yaml"]
